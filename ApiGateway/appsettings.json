
{
  "ReverseProxy": {
    "Routes": {
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous",
        "Transforms": [
          {
            "PathPattern": "/api/Auth/{**catch-all}"
          }
        ]
      },

      "product-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous",
        "Transforms": [
          {
            "PathPattern": "/api/Product/{**catch-all}"
          }
        ]
      },

      "category-read-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/categories/{**catch-all}",
          "Methods": [ "GET" ]
        },
        "AuthorizationPolicy": "anonymous",
        "Transforms": [
          {
            "PathPattern": "/api/Category/{**catch-all}"
          }
        ]
      },

      "category-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/categories/{**catch-all}",
          "Methods": [ "POST", "PUT", "DELETE" ]
        },
        "AuthorizationPolicy": "default",
        "Transforms": [
          {
            "PathPattern": "/api/Category/{**catch-all}"
          }
        ]
      },

      "inventory-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/inventory/{**catch-all}"
        },
        "AuthorizationPolicy": "default",
        "Transforms": [
          {
            "PathPattern": "/api/Inventory/{**catch-all}"
          }
        ]
      },

      "cart-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/cart/{**catch-all}"
        },
        "AuthorizationPolicy": "default",
        "Transforms": [
          {
            "PathPattern": "/api/Cart/{**catch-all}"
          }
        ]
      },

      "order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        },
        "AuthorizationPolicy": "default",
        "Transforms": [
          {
            "PathPattern": "/api/Order/{**catch-all}"
          }
        ]
      },

      "notification-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        },
        "AuthorizationPolicy": "default",
        "Transforms": [
          {
            "PathPattern": "/api/Notifications/{**catch-all}"
          }
        ]
      },

      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },

      "chat-route": {
        "ClusterId": "chat-cluster",
        "Match": {
          "Path": "/api/chat/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous",
        "Transforms": [
          {
            "PathPattern": "/api/Chat/{**catch-all}"
          }
        ]
      },

      "hubs-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous"
      }
    },

    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "user-service": {
            "Address": "http://userservice:8080/"
          }
        }
      },

      "product-cluster": {
        "Destinations": {
          "product-service": {
            "Address": "http://productservice:8080/"
          }
        }
      },

      "order-cluster": {
        "Destinations": {
          "order-service": {
            "Address": "http://orderservice:8080/"
          }
        }
      },

      "payment-cluster": {
        "Destinations": {
          "payment-service": {
            "Address": "http://paymentservice:8080/"
          }
        }
      },

      "chat-cluster": {
        "Destinations": {
          "chat-service": {
            "Address": "http://chatservice:8080/"
          }
        }
      }
    }
  }
}
